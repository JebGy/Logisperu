---
import Layout from '../layouts/Layout.astro';
const n8nWebhookUrl = import.meta.env.PUBLIC_N8N_WEBHOOK_URL || '';
---

<Layout title="LOGISPERÚ | Portal de Homologación y Gestión de Proveedores">
  <!-- 1. HEADER / STICKY NAVBAR -->
  <header class="sticky top-0 z-50 border-b border-slate-200 bg-white/95 backdrop-blur-md">
    <div class="mx-auto flex h-20 max-w-7xl items-center justify-between px-6 lg:px-8">
      {/* Brand Logo */}
      <a href="/" class="flex items-center gap-3 group">
        <img src="/LOGISPERULOGO.svg" alt="LOGISPERÚ" class="h-9 w-auto object-contain" />
      </a>

      {/* Desktop Navigation */}
      <nav class="hidden md:flex items-center gap-7 text-sm font-medium text-slate-600">
        <a href="#modulos" class="transition-colors hover:text-blue-600">Módulos</a>
        <a href="#sectores" class="transition-colors hover:text-blue-600">Sectores</a>
        <a href="#problema" class="transition-colors hover:text-blue-600">Diagnóstico</a>
        <a href="#roi" class="transition-colors hover:text-blue-600">Métricas</a>
        <a href="#planes" class="transition-colors hover:text-blue-600">Planes</a>
        <a href="#faq" class="transition-colors hover:text-blue-600">Preguntas</a>
      </nav>

      {/* Header Action CTAs */}
      <div class="flex items-center gap-3">
        <a
          href="https://proveedores.logisperu.pe/login"
          target="_blank"
          rel="noopener noreferrer"
          class="hidden sm:inline-flex px-3.5 py-2 text-xs sm:text-sm font-medium text-slate-700 hover:text-slate-950 hover:bg-slate-100 rounded-lg transition-colors"
        >
          Acceso al Portal
        </a>
        <a
          href="#demo-form"
          class="inline-flex items-center justify-center px-4 py-2 text-xs sm:text-sm font-semibold text-white bg-blue-600 hover:bg-blue-700 rounded-lg transition-all shadow-sm"
        >
          Solicitar Demostración
        </a>
      </div>
    </div>
  </header>

  <main class="flex-1">
    {/* 2. HERO SECTION */}
    <section class="relative overflow-hidden bg-white border-b border-slate-200 py-16 md:py-24">
      {/* Background grid texture */}
      <div class="absolute inset-0 bg-[linear-gradient(to_right,#f1f5f9_1px,transparent_1px),linear-gradient(to_bottom,#f1f5f9_1px,transparent_1px)] bg-[size:4rem_4rem] [mask-image:radial-gradient(ellipse_60%_50%_at_50%_0%,#000_70%,transparent_100%)] opacity-60 pointer-events-none"></div>

      <div class="relative mx-auto max-w-7xl px-6 lg:px-8 space-y-12">
        <div class="max-w-3xl mx-auto text-center space-y-6">
          {/* Functional Category Descriptor */}
          <div class="inline-flex items-center gap-2 rounded-full border border-slate-200 bg-slate-50 px-3.5 py-1 text-xs font-mono font-semibold text-slate-700">
            <span class="h-1.5 w-1.5 rounded-full bg-blue-600"></span>
            PORTAL DE HOMOLOGACIÓN Y GESTIÓN DE PROVEEDORES
          </div>

          {/* H1 Headline */}
          <h1 class="text-4xl font-bold tracking-tight text-slate-950 sm:text-5xl md:text-6xl leading-[1.12] text-balance">
            Centraliza, homologa y audita a tus proveedores en un solo lugar.
          </h1>

          {/* Subtitle */}
          <p class="text-base sm:text-lg text-slate-600 leading-relaxed max-w-2xl mx-auto">
            Plataforma B2B para compras y abastecimiento. Permite que tus proveedores registren su información legal, tributaria y bancaria en un entorno digital seguro, reduciendo el tiempo de alta y aprobación a 48 horas.
          </p>

          {/* CTAs */}
          <div class="flex flex-wrap items-center justify-center gap-4 pt-2">
            <a
              href="#demo-form"
              class="inline-flex items-center gap-2 px-7 py-3 text-sm font-semibold text-white bg-blue-600 hover:bg-blue-700 rounded-xl transition-all shadow-md shadow-blue-600/15"
            >
              <span>Solicitar Demostración Comercial</span>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </a>
            <a
              href="#modulos"
              class="inline-flex items-center px-6 py-3 text-sm font-semibold text-slate-700 bg-white hover:bg-slate-50 border border-slate-300 rounded-xl transition-colors"
            >
              Ver Módulos del Sistema
            </a>
          </div>

          {/* Metadata Validation Bar */}
          <div class="pt-8 grid grid-cols-2 md:grid-cols-4 gap-3 text-left">
            <div class="p-3.5 rounded-xl border border-slate-200 bg-slate-50/80 space-y-1">
              <div class="flex items-center gap-1.5 text-blue-600 font-bold text-xs">
                <svg class="w-4 h-4 shrink-0" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                </svg>
                <span class="text-slate-900">SUNAT & RUC</span>
              </div>
              <p class="text-[11px] text-slate-500 leading-tight">Validación de RUC 11 dígitos y poderes legales.</p>
            </div>

            <div class="p-3.5 rounded-xl border border-slate-200 bg-slate-50/80 space-y-1">
              <div class="flex items-center gap-1.5 text-blue-600 font-bold text-xs">
                <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z" />
                </svg>
                <span class="text-slate-900">Bancos & CCI</span>
              </div>
              <p class="text-[11px] text-slate-500 leading-tight">Cuentas corrientes y detracción verificadas.</p>
            </div>

            <div class="p-3.5 rounded-xl border border-slate-200 bg-slate-50/80 space-y-1">
              <div class="flex items-center gap-1.5 text-blue-600 font-bold text-xs">
                <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                </svg>
                <span class="text-slate-900">MinIO / S3 Cifrado</span>
              </div>
              <p class="text-[11px] text-slate-500 leading-tight">Almacenamiento de archivos con cifrado TLS.</p>
            </div>

            <div class="p-3.5 rounded-xl border border-slate-200 bg-slate-50/80 space-y-1">
              <div class="flex items-center gap-1.5 text-blue-600 font-bold text-xs">
                <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01" />
                </svg>
                <span class="text-slate-900">Marca Blanca</span>
              </div>
              <p class="text-[11px] text-slate-500 leading-tight">Tu logo, colores y dominio en 5 días.</p>
            </div>
          </div>
        </div>

        {/* High-Fidelity UI Mockup */}
        <div class="rounded-2xl border border-slate-200 bg-slate-900 p-2 shadow-2xl">
          <div class="rounded-xl border border-slate-800 bg-slate-950 overflow-hidden text-slate-100 font-sans">
            {/* Window Top Bar */}
            <div class="flex items-center justify-between px-4 py-3 border-b border-slate-800 bg-slate-900/60">
              <div class="flex items-center gap-2">
                <span class="h-3 w-3 rounded-full bg-red-500/80 inline-block"></span>
                <span class="h-3 w-3 rounded-full bg-amber-500/80 inline-block"></span>
                <span class="h-3 w-3 rounded-full bg-emerald-500/80 inline-block"></span>
                <span class="text-xs text-slate-400 font-mono ml-2">proveedores.logisperu.pe/admin/providers</span>
              </div>
              <div class="flex items-center gap-2 text-xs text-slate-400">
                <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded bg-emerald-500/10 text-emerald-400 font-mono text-[11px] border border-emerald-500/20">
                  <span class="h-1.5 w-1.5 rounded-full bg-emerald-400"></span>
                  Sistema Activo
                </span>
              </div>
            </div>

            {/* Dashboard Inner Screen */}
            <div class="p-6 space-y-6">
              {/* Stats Summary */}
              <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
                <div class="rounded-lg bg-slate-900/90 border border-slate-800 p-3.5">
                  <div class="text-xs text-slate-400 font-medium">Proveedores Registrados</div>
                  <div class="text-2xl font-bold font-mono text-white mt-1">524</div>
                  <div class="text-[10px] text-emerald-400 mt-0.5">+14 este mes</div>
                </div>
                <div class="rounded-lg bg-slate-900/90 border border-slate-800 p-3.5">
                  <div class="text-xs text-slate-400 font-medium">Pendientes de Aprobación</div>
                  <div class="text-2xl font-bold font-mono text-amber-400 mt-1">18</div>
                  <div class="text-[10px] text-slate-400 mt-0.5">Requieren revisión técnica</div>
                </div>
                <div class="rounded-lg bg-slate-900/90 border border-slate-800 p-3.5">
                  <div class="text-xs text-slate-400 font-medium">Tiempo Promedio de Alta</div>
                  <div class="text-2xl font-bold font-mono text-blue-400 mt-1">1.8 d</div>
                  <div class="text-[10px] text-blue-300 mt-0.5">-80% vs proceso manual</div>
                </div>
                <div class="rounded-lg bg-slate-900/90 border border-slate-800 p-3.5">
                  <div class="text-xs text-slate-400 font-medium">Expedientes Digitales</div>
                  <div class="text-2xl font-bold font-mono text-emerald-400 mt-1">100%</div>
                  <div class="text-[10px] text-slate-400 mt-0.5">Almacenados en MinIO S3</div>
                </div>
              </div>

              {/* Providers Table Mockup */}
              <div class="rounded-xl border border-slate-800 overflow-hidden bg-slate-900/40">
                <div class="px-4 py-3 border-b border-slate-800 flex items-center justify-between">
                  <span class="text-xs font-semibold text-slate-200">Bandeja de Homologación de Proveedores</span>
                  <span class="text-[11px] text-slate-400 font-mono">Filtro: Todos los estados</span>
                </div>
                <div class="overflow-x-auto">
                  <table class="w-full text-left text-xs">
                    <thead class="bg-slate-900 text-slate-400 uppercase text-[10px] border-b border-slate-800">
                      <tr>
                        <th class="px-4 py-2.5">Razón Social & RUC</th>
                        <th class="px-4 py-2.5">Familia de Suministro</th>
                        <th class="px-4 py-2.5">Condición de Pago</th>
                        <th class="px-4 py-2.5">Estado</th>
                        <th class="px-4 py-2.5 text-right">Acción</th>
                      </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-800 text-slate-300">
                      <tr class="hover:bg-slate-800/50 transition-colors">
                        <td class="px-4 py-3">
                          <div class="font-semibold text-white">FERREYROS S.A.</div>
                          <div class="text-[11px] font-mono text-slate-400">RUC: 20100028639</div>
                        </td>
                        <td class="px-4 py-3">
                          <span class="px-2 py-0.5 rounded bg-blue-500/10 text-blue-300 text-[11px] border border-blue-500/20">
                            Repuestos Minería
                          </span>
                        </td>
                        <td class="px-4 py-3 font-mono">Crédito 30 días (USD)</td>
                        <td class="px-4 py-3">
                          <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full bg-emerald-500/10 text-emerald-400 text-[11px] font-medium border border-emerald-500/20">
                            <span class="h-1.5 w-1.5 rounded-full bg-emerald-400"></span>
                            Aprobado
                          </span>
                        </td>
                        <td class="px-4 py-3 text-right">
                          <span class="text-blue-400 hover:text-blue-300 font-medium cursor-pointer">Ver Ficha 360° &rarr;</span>
                        </td>
                      </tr>
                      <tr class="hover:bg-slate-800/50 transition-colors">
                        <td class="px-4 py-3">
                          <div class="font-semibold text-white">CORPORACIÓN ACEROS AREQUIPA S.A.</div>
                          <div class="text-[11px] font-mono text-slate-400">RUC: 20370146994</div>
                        </td>
                        <td class="px-4 py-3">
                          <span class="px-2 py-0.5 rounded bg-amber-500/10 text-amber-300 text-[11px] border border-amber-500/20">
                            Materiales Construcción
                          </span>
                        </td>
                        <td class="px-4 py-3 font-mono">Crédito 60 días (PEN)</td>
                        <td class="px-4 py-3">
                          <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full bg-amber-500/10 text-amber-400 text-[11px] font-medium border border-amber-500/20">
                            <span class="h-1.5 w-1.5 rounded-full bg-amber-400"></span>
                            En Revisión
                          </span>
                        </td>
                        <td class="px-4 py-3 text-right">
                          <span class="text-blue-400 hover:text-blue-300 font-medium cursor-pointer">Evaluar Documentos &rarr;</span>
                        </td>
                      </tr>
                      <tr class="hover:bg-slate-800/50 transition-colors">
                        <td class="px-4 py-3">
                          <div class="font-semibold text-white">TRANSPORTE Y LOGÍSTICA DEL PACÍFICO S.A.C.</div>
                          <div class="text-[11px] font-mono text-slate-400">RUC: 20549281920</div>
                        </td>
                        <td class="px-4 py-3">
                          <span class="px-2 py-0.5 rounded bg-purple-500/10 text-purple-300 text-[11px] border border-purple-500/20">
                            Transporte Carga Pesada
                          </span>
                        </td>
                        <td class="px-4 py-3 font-mono">Contado 15 días (PEN)</td>
                        <td class="px-4 py-3">
                          <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full bg-blue-500/10 text-blue-400 text-[11px] font-medium border border-blue-500/20">
                            <span class="h-1.5 w-1.5 rounded-full bg-blue-400"></span>
                            Pendiente
                          </span>
                        </td>
                        <td class="px-4 py-3 text-right">
                          <span class="text-blue-400 hover:text-blue-300 font-medium cursor-pointer">Revisar Alta &rarr;</span>
                        </td>
                      </tr>
                    </tbody>
                  </table>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    {/* 3. SECTORES INDUSTRIALES */}
    <section id="sectores" class="py-20 bg-slate-50 border-b border-slate-200">
      <div class="mx-auto max-w-7xl px-6 lg:px-8 space-y-12">
        <div class="max-w-2xl space-y-3">
          <div class="text-xs font-mono uppercase tracking-wider text-blue-600 font-bold">
            Adaptabilidad por Rubro
          </div>
          <h2 class="text-3xl font-bold tracking-tight text-slate-950 sm:text-4xl">
            Solución adaptada a los estándares de las principales industrias en Perú.
          </h2>
          <p class="text-sm text-slate-600 leading-relaxed">
            Cada sector productivo tiene exigencias únicas de homologación. Nuestra plataforma se configura a la medida de tus políticas de abastecimiento.
          </p>
        </div>

        {/* Sectors Grid with Pure SVGs */}
        <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {/* Sector 1: Construcción */}
          <div class="rounded-2xl border border-slate-200 bg-white p-7 space-y-4 shadow-sm hover:border-blue-300 transition-all flex flex-col justify-between">
            <div class="space-y-3">
              <div class="h-11 w-11 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                </svg>
              </div>
              <h3 class="font-bold text-lg text-slate-900">Construcción e Infraestructura</h3>
              <p class="text-xs text-slate-600 leading-relaxed">
                Control de subcontratistas, vigencia de pólizas CAR/SCTR, seguros de obra y consorcios para proyectos descentralizados.
              </p>
            </div>
            <div class="pt-3 border-t border-slate-100 flex items-center justify-between text-[11px] font-mono">
              <span class="text-slate-500">Impacto en Obra</span>
              <span class="text-emerald-600 font-bold">-70% retraso en compras</span>
            </div>
          </div>

          {/* Sector 2: Minería */}
          <div class="rounded-2xl border border-slate-200 bg-white p-7 space-y-4 shadow-sm hover:border-blue-300 transition-all flex flex-col justify-between">
            <div class="space-y-3">
              <div class="h-11 w-11 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M13 10V3L4 14h7v7l9-11h-7z" />
                </svg>
              </div>
              <h3 class="font-bold text-lg text-slate-900">Minería, Energía e Hidrocarburos</h3>
              <p class="text-xs text-slate-600 leading-relaxed">
                Homologación rigurosa de estándares de seguridad (SST), impacto ambiental, antecedentes y control de proveedores locales.
              </p>
            </div>
            <div class="pt-3 border-t border-slate-100 flex items-center justify-between text-[11px] font-mono">
              <span class="text-slate-500">Auditoría y Compliance</span>
              <span class="text-emerald-600 font-bold">100% Trazabilidad</span>
            </div>
          </div>

          {/* Sector 3: Logística */}
          <div class="rounded-2xl border border-slate-200 bg-white p-7 space-y-4 shadow-sm hover:border-blue-300 transition-all flex flex-col justify-between">
            <div class="space-y-3">
              <div class="h-11 w-11 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9 17a2 2 0 11-4 0 2 2 0 014 0zM19 17a2 2 0 11-4 0 2 2 0 014 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M13 16V6a1 1 0 00-1-1H4a1 1 0 00-1 1v10a1 1 0 001 1h1m8-1a1 1 0 01-1 1H9m4-1V8a1 1 0 011-1h2.586a1 1 0 01.707.293l3.414 3.414a1 1 0 01.293.707V16a1 1 0 01-1 1h-1m-6-1a1 1 0 001 1h1M5 17a2 2 0 104 0m-4 0a2 2 0 114 0m6 0a2 2 0 104 0m-4 0a2 2 0 114 0" />
                </svg>
              </div>
              <h3 class="font-bold text-lg text-slate-900">Operadores Logísticos y Transporte</h3>
              <p class="text-xs text-slate-600 leading-relaxed">
                Registro masivo de transportistas, seguros de carga (TREC), revisión técnica y validación de cuentas de detracción del Banco de la Nación.
              </p>
            </div>
            <div class="pt-3 border-t border-slate-100 flex items-center justify-between text-[11px] font-mono">
              <span class="text-slate-500">Alta de Flotas</span>
              <span class="text-emerald-600 font-bold">Alta masiva en 24h</span>
            </div>
          </div>

          {/* Sector 4: Agro */}
          <div class="rounded-2xl border border-slate-200 bg-white p-7 space-y-4 shadow-sm hover:border-blue-300 transition-all flex flex-col justify-between">
            <div class="space-y-3">
              <div class="h-11 w-11 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />
                </svg>
              </div>
              <h3 class="font-bold text-lg text-slate-900">Agroindustria y Exportación</h3>
              <p class="text-xs text-slate-600 leading-relaxed">
                Verificación de certificaciones técnicas, SENASA, GlobalGAP, trazabilidad de insumos agrícolas, fertilizantes y envases.
              </p>
            </div>
            <div class="pt-3 border-t border-slate-100 flex items-center justify-between text-[11px] font-mono">
              <span class="text-slate-500">Calidad Fitosanitaria</span>
              <span class="text-emerald-600 font-bold">Cero Observaciones</span>
            </div>
          </div>

          {/* Sector 5: Retail */}
          <div class="rounded-2xl border border-slate-200 bg-white p-7 space-y-4 shadow-sm hover:border-blue-300 transition-all flex flex-col justify-between">
            <div class="space-y-3">
              <div class="h-11 w-11 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
                </svg>
              </div>
              <h3 class="font-bold text-lg text-slate-900">Retail y Distribución Masiva</h3>
              <p class="text-xs text-slate-600 leading-relaxed">
                Gestión masiva de condiciones de pago a 30/60/90 días, monedas (PEN/USD) y catálogo de líneas de suministro.
              </p>
            </div>
            <div class="pt-3 border-t border-slate-100 flex items-center justify-between text-[11px] font-mono">
              <span class="text-slate-500">Acuerdos Comerciales</span>
              <span class="text-emerald-600 font-bold">100% Blindaje</span>
            </div>
          </div>

